{
  "name": "my-app",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22" },
  "pnpm": { "onlyBuiltDependencies": ["esbuild"] },
  "repository": { "type": "git", "url": "git+https://github.com/freeappstore-online/my-app.git" },
  "scripts": {
    "dev": "pnpm --filter @my-app/web dev",
    "build": "pnpm --filter @my-app/web build",
    "preview": "pnpm --filter @my-app/web preview",
    "typecheck": "pnpm --filter @my-app/web exec tsc -b",
    "test": "pnpm --filter @my-app/web exec tsc -b"
  }
}
